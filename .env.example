# Database (Neon, Supabase, or any Postgres)
DATABASE_URL="postgresql://user:password@host:5432/marketplace"

# Redis for caching (Upstash recommended)
REDIS_URL="redis://default:password@host:6379"

# Your platform domain (used for webhook registration)
NEXT_PUBLIC_APP_URL="https://your-marketplace.com"

# Secret for verifying Shopify webhooks
SHOPIFY_WEBHOOK_SECRET="your-webhook-secret"

# Admin access key (simple protection for /admin)
ADMIN_SECRET_KEY="your-admin-password"
